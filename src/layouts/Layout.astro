---
// Layout.astro - document shell: metadata, fonts, header, side navigation, footer.
import '../styles/global.css';
import Header from '../components/Header.astro';
import SideNav from '../components/SideNav.astro';
import Footer from '../components/Footer.astro';

const {
  title,
  description = 'MindTopo tests topological intuition in foundation models with a 3,900-instance Core Set and an exact-input-disjoint 8,780-instance Extended Set across 13 tasks.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-card.jpg', Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <meta name="theme-color" content="#f6f8f8" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="MindTopo, topological reasoning, topological intuition, topology benchmark, spatial reasoning, multimodal large language models, MLLM, foundation models, video generation, world model, planning, Piaget, continuity, separation, order, enclosure, knots" />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MindTopo" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ManlingLi_" />
    <meta name="twitter:creator" content="@ManlingLi_" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <SideNav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import { initSite } from '../scripts/site';
      initSite();
    </script>
  </body>
</html>
