---
// Findings.astro - the paper in six conclusions. Each card links to its evidence below.
import SectionHeader from './SectionHeader.astro';
import Icon from './Icon.astro';
import { FACTS, ERRORS, rowsFor, fmt } from '../data/site';

const f = FACTS;
const gap = rowsFor('all')
  .filter((r) => r.model.group !== 'reference')
  .sort((a, b) => b.reasoning - a.reasoning);
const scaleMax = 70;

const sum = (split: 'reasoning' | 'planning', keys: string[]) =>
  keys.reduce((acc, k) => acc + ERRORS[split][k].Combined, 0);
const total = (split: 'reasoning' | 'planning') => sum(split, Object.keys(ERRORS[split]));
const perceptionShare = (100 * sum('reasoning', ['Perception grounding'])) / total('reasoning');
const downstreamShare =
  (100 * sum('planning', ['Feature state prediction', 'Dynamic violation', 'Action planning'])) / total('planning');

const t = f.training;
const reasonGain = t.bestReasoning - t.baseReasoning;
const planGain = t.bestPlanning - t.basePlanning;
---
<section id="findings" class="section">
  <div class="wrap">
    <SectionHeader id="findings" title="Six things we learned" />

    <div class="findings-grid">
      <a href="#results" class="finding card f-gap" data-reveal>
        <span class="f-kicker">Recognition does not transfer to action</span>
        <span class="f-figure"><span data-countup={f.planBelowReason}>{f.planBelowReason}</span><span class="f-of">/ {f.models}</span></span>
        <span class="f-claim">models score lower on planning than on reasoning.</span>
        <span class="mini-gap" aria-hidden="true">
          {gap.map((r) => (
            <span class="mini-row">
              <span class="mini-name">{r.model.short}</span>
              <span class="mini-track">
                <span class="mini-bar" style={`left:${(100 * r.planning) / scaleMax}%;width:${(100 * (r.reasoning - r.planning)) / scaleMax}%`}></span>
                <span class="mini-dot plan" style={`left:${(100 * r.planning) / scaleMax}%`}></span>
                <span class="mini-dot reason" style={`left:${(100 * r.reasoning) / scaleMax}%`}></span>
              </span>
            </span>
          ))}
        </span>
        <span class="mini-legend" aria-hidden="true"><i class="reason"></i>Reasoning avg <i class="plan"></i>Planning avg</span>
        <span class="f-link">See the action gap <Icon name="arrow-right" size={14} /></span>
      </a>

      <a href="#humans" class="finding card" data-reveal style="--reveal-delay:.06s">
        <span class="f-kicker">Far below humans</span>
        <span class="f-figure"><span data-countup={f.bestEasy.reasoning.toFixed(1)} data-digits="1">{fmt(f.bestEasy.reasoning)}</span><span class="f-unit">%</span></span>
        <span class="f-claim">best model on Easy reasoning, vs <strong>{fmt(f.humanEasy.reasoning)}%</strong> for humans.</span>
        <span class="f-link">Compare per task <Icon name="arrow-right" size={14} /></span>
      </a>

      <a href="#results" class="finding card" data-reveal style="--reveal-delay:.12s">
        <span class="f-kicker">Open-weight models barely plan</span>
        <span class="f-figure"><span class="f-unit">≤</span>{fmt(f.openWeightMaxPlan)}<span class="f-unit">%</span></span>
        <span class="f-claim">average planning success, next to <strong>{fmt(f.randomPlan, 2)}%</strong> for random legal moves.</span>
        <span class="f-link">Open the leaderboard <Icon name="arrow-right" size={14} /></span>
      </a>

      <a href="#training" class="finding card" data-reveal style="--reveal-delay:.06s">
        <span class="f-kicker">Training teaches patterns, not plans</span>
        <span class="f-figure f-pair"><span class="reason-ink">+{fmt(reasonGain)}</span><span class="f-vs">vs</span><span class="plan-ink">+{fmt(planGain)}</span></span>
        <span class="f-claim">points from SFT + RL on reasoning vs planning (Qwen3-VL-2B).</span>
        <span class="f-link">See what training fixes <Icon name="arrow-right" size={14} /></span>
      </a>

      <a href="#errors" class="finding card" data-reveal style="--reveal-delay:.12s">
        <span class="f-kicker">Seeing vs acting</span>
        <span class="f-figure"><span data-countup={perceptionShare.toFixed(1)} data-digits="1">{fmt(perceptionShare)}</span><span class="f-unit">%</span></span>
        <span class="f-claim">of reasoning failures are perception; <strong>{fmt(downstreamShare)}%</strong> of planning failures come later, in state, dynamics and action.</span>
        <span class="f-link">Browse failure modes <Icon name="arrow-right" size={14} /></span>
      </a>

      <a href="#imagination" class="finding card f-wide" data-reveal>
        <span class="f-kicker">Imagination without validity</span>
        <span class="f-wide-body">
          <span class="f-figure"><span>0</span><span class="f-of">/ {f.video.rollouts.toLocaleString('en-US')}</span></span>
          <span class="f-claim">generated video rollouts are process-valid. Six video models reach a solved final frame in up to <strong>{fmt(f.video.bestEndpoint)}%</strong> of rollouts, but none gets there through legal moves.</span>
        </span>
        <span class="f-link">Watch them break <Icon name="arrow-right" size={14} /></span>
      </a>
    </div>
  </div>
</section>

<style>
  .findings-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .finding {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 24px 24px 20px;
    color: var(--ink);
    text-decoration: none;
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease), border-color 0.3s;
  }

  .finding:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-2);
    border-color: #d3dde0;
  }

  .f-gap {
    grid-row: span 2;
  }

  .f-wide {
    grid-column: 1 / -1;
  }

  .f-kicker {
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--brand-2);
  }

  .f-figure {
    display: flex;
    align-items: baseline;
    gap: 4px;
    margin-top: 6px;
    font-size: clamp(2.4rem, 4.4vw, 3.4rem);
    font-weight: 750;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .f-unit,
  .f-of {
    font-size: 0.48em;
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--ink-3);
  }

  .f-pair {
    gap: 10px;
    font-size: clamp(2rem, 3.6vw, 2.8rem);
  }

  .f-vs {
    font-size: 0.42em;
    font-weight: 600;
    color: var(--ink-3);
  }

  .reason-ink {
    color: #075b80;
  }

  .plan-ink {
    color: #b8471a;
  }

  .f-claim {
    font-size: 0.98rem;
    line-height: 1.45;
    color: var(--ink-2);
  }

  .f-claim strong {
    color: var(--ink);
  }

  .f-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding-top: 14px;
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--link);
  }

  .finding:hover .f-link :global(svg) {
    transform: translateX(3px);
  }

  .f-link :global(svg) {
    transition: transform 0.25s var(--ease);
  }

  .f-wide-body {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 22px;
  }

  .f-wide-body .f-claim {
    flex: 1 1 380px;
    font-size: 1.02rem;
  }

  /* Mini action-gap chart inside the first card */
  .mini-gap {
    display: grid;
    gap: 5px;
    margin-top: 18px;
  }

  .mini-row {
    display: grid;
    grid-template-columns: 112px 1fr;
    align-items: center;
    gap: 10px;
  }

  .mini-name {
    font-size: 0.72rem;
    color: var(--ink-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mini-track {
    position: relative;
    height: 10px;
  }

  .mini-track::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: var(--grid);
  }

  .mini-bar {
    position: absolute;
    top: 50%;
    height: 2px;
    margin-top: -1px;
    background: #c9d3d7;
  }

  .mini-dot {
    position: absolute;
    top: 50%;
    width: 8px;
    height: 8px;
    margin: -4px 0 0 -4px;
    border-radius: 50%;
    box-shadow: 0 0 0 2px var(--surface);
  }

  .mini-dot.reason,
  .mini-legend i.reason {
    background: var(--reason);
  }

  .mini-dot.plan,
  .mini-legend i.plan {
    background: var(--plan);
  }

  .mini-legend {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
    font-size: 0.74rem;
    color: var(--ink-3);
  }

  .mini-legend i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-left: 6px;
  }

  .mini-legend i:first-child {
    margin-left: 0;
  }

  @media (max-width: 980px) {
    .findings-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .f-gap {
      grid-row: auto;
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 620px) {
    .findings-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
