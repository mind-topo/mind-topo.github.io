---
// Humans.astro - per-task profile of one model against humans on the Easy level
// (the only level with human evaluation). The radar is drawn here for the default
// model; src/scripts/humans.ts morphs it when another model is picked.
import SectionHeader from './SectionHeader.astro';
import { MODELS, TASKS } from '../data/site';
import { radarGeometry, humanComparison, RADAR } from '../data/humans';

const defaultModel = MODELS[0];
const g = radarGeometry(defaultModel.id);
const c = humanComparison(defaultModel.id);
---
<section id="humans" class="section tinted">
  <div class="wrap">
    <SectionHeader id="humans" title="Even the strongest model trails humans on most tasks">
      Easy level, the level with human evaluation: five professional annotators evaluated the previous release of the
      benchmark, whose instances form the Easy level, under the same instructions as the models (inter-annotator
      agreement 0.89). The Origami Point human score is from the previous release, since that task was regenerated afterwards.
    </SectionHeader>

    <div class="controls" data-reveal>
      <span class="control-label" id="radar-label">Compare humans with</span>
      <div class="chip-row" role="radiogroup" aria-labelledby="radar-label" id="radar-control">
        {MODELS.map((m, i) => (
          <button class="chip" role="radio" aria-checked={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-value={m.id} title={m.name}>{m.short}</button>
        ))}
      </div>
    </div>

    <figure class="card figure-card radar-card" data-reveal>
      <div class="radar-wrap">
        <svg class="radar" id="radar" viewBox={`0 0 ${RADAR.size} ${RADAR.size}`} role="img" aria-labelledby="radar-desc">
          <desc id="radar-desc">Radar chart of per-task scores on the Easy level for humans and the selected model.</desc>
          {RADAR.rings.map((r) => <circle class="ring" cx={RADAR.c} cy={RADAR.c} r={(r / 100) * RADAR.r} />)}
          {g.axes.map((a) => <line class="axis" x1={RADAR.c} y1={RADAR.c} x2={a.x} y2={a.y} />)}
          {RADAR.rings.map((r) => <text class="ring-label" x={RADAR.c + 4} y={RADAR.c - (r / 100) * RADAR.r - 3}>{r}</text>)}
          <polygon class="poly human" points={g.human} />
          <polygon class="poly model" id="radar-model" points={g.model} />
          {g.humanPts.map((p) => <circle class="vx human" cx={p.x} cy={p.y} r="3.5" />)}
          {g.modelPts.map((p, i) => <circle class="vx model" data-i={i} cx={p.x} cy={p.y} r="4.5" />)}
          {g.labels.map((l, i) => (
            <text class={`axis-label ${TASKS[i].kind}`} x={l.x} y={l.y} text-anchor={l.anchor} dominant-baseline="middle">
              <tspan class="kind-dot" dx="0">●</tspan><tspan dx="4">{TASKS[i].name}</tspan>
            </text>
          ))}
          {g.axes.map((a, i) => (
            <line class="hit" data-i={i} x1={RADAR.c} y1={RADAR.c} x2={a.x} y2={a.y} tabindex="0" aria-label={TASKS[i].name} />
          ))}
        </svg>
        <div class="radar-legend legend" aria-hidden="true">
          <span class="legend-item"><span class="swatch line-key human"></span>Human</span>
          <span class="legend-item"><span class="swatch line-key model"></span><span id="radar-model-name">{defaultModel.short}</span></span>
          <span class="legend-item"><span class="swatch dot" style="background:var(--reason)"></span>reasoning task</span>
          <span class="legend-item"><span class="swatch dot" style="background:var(--plan)"></span>planning task</span>
        </div>
      </div>

      <div class="radar-side">
        <div class="avg-tiles">
          {(['reasoning', 'planning'] as const).map((k) => (
            <div class="avg-tile">
              <p class="avg-label">{k === 'reasoning' ? 'Reasoning avg' : 'Planning avg'}</p>
              <p class="avg-values">
                <span class="avg-model" data-avg={k}>{c[k].model.toFixed(1)}</span>
                <span class="avg-vs">vs</span>
                <span class="avg-human">{c[k].human.toFixed(1)}</span>
              </p>
              <p class="avg-note"><span data-avg-gap={k}>{(c[k].model - c[k].human).toFixed(1)}</span> pts from humans</p>
            </div>
          ))}
        </div>

        <div class="gap-list">
          <p class="side-title">Largest gaps to humans</p>
          <ol id="gap-list">
            {c.gaps.map((x) => (
              <li>
                <span class="gl-name">{x.task}</span>
                <span class="gl-bars"><span class="gl-human" style={`width:${x.human}%`}></span><span class="gl-model" style={`width:${x.model}%`}></span></span>
                <span class="gl-gap tabular">−{x.gap.toFixed(1)}</span>
              </li>
            ))}
          </ol>
        </div>

        <p class="match-note" id="match-note">{c.matchText}</p>
      </div>
    </figure>

    <details class="table-view" data-reveal>
      <summary>Show data table</summary>
      <div class="table-scroll"><table id="radar-table"></table></div>
    </details>
  </div>
</section>

<script>
  import { initHumans } from '../scripts/humans';
  initHumans();
</script>

<style>
  .radar-card {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(20px, 3vw, 40px);
    align-items: center;
  }

  .radar {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .ring {
    fill: none;
    stroke: var(--grid);
  }

  .axis {
    stroke: var(--grid);
  }

  .ring-label {
    font-size: 10px;
    fill: var(--ink-3);
  }

  .poly {
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .poly.human {
    fill: rgba(43, 52, 56, 0.05);
    stroke: var(--human);
  }

  .poly.model {
    fill: rgba(98, 80, 214, 0.16);
    stroke: var(--model);
  }

  .vx.human {
    fill: var(--human);
    stroke: var(--surface);
    stroke-width: 1.5;
  }

  .vx.model {
    fill: var(--model);
    stroke: var(--surface);
    stroke-width: 2;
  }

  .axis-label {
    font-size: 14px;
    font-weight: 550;
    fill: var(--ink-2);
  }

  .axis-label .kind-dot {
    font-size: 9px;
  }

  .axis-label.reasoning .kind-dot {
    fill: var(--reason);
  }

  .axis-label.planning .kind-dot {
    fill: var(--plan);
  }

  .axis-label.on {
    fill: var(--ink);
    font-weight: 700;
  }

  .hit {
    stroke: transparent;
    stroke-width: 30;
    cursor: pointer;
  }

  .hit:focus-visible {
    outline: none;
    stroke: rgba(98, 80, 214, 0.12);
  }

  .radar-legend {
    justify-content: center;
    margin-top: 10px;
  }

  .line-key {
    width: 16px;
    height: 3px;
    border-radius: 2px;
  }

  .line-key.human {
    background: var(--human);
  }

  .line-key.model {
    background: var(--model);
  }

  .avg-tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .avg-tile {
    padding: 14px 16px;
    border-radius: 12px;
    background: var(--surface-2);
  }

  .avg-label {
    font-size: 0.78rem;
    color: var(--ink-3);
    font-weight: 600;
  }

  .avg-values {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-top: 4px;
  }

  .avg-model {
    font-size: 1.9rem;
    font-weight: 750;
    letter-spacing: -0.03em;
    color: #4a3aa7;
  }

  .avg-vs {
    font-size: 0.8rem;
    color: var(--ink-3);
  }

  .avg-human {
    font-size: 1.15rem;
    font-weight: 650;
    color: var(--human);
  }

  .avg-note {
    font-size: 0.78rem;
    color: var(--ink-3);
  }

  .gap-list {
    margin-top: 22px;
  }

  .side-title {
    font-size: 0.86rem;
    font-weight: 650;
    margin-bottom: 8px;
  }

  .gap-list ol {
    list-style: none;
    display: grid;
    gap: 8px;
  }

  /* List items are re-rendered by src/scripts/humans.ts, so these rules must be global. */
  .gap-list :global(li) {
    display: grid;
    grid-template-columns: 92px 1fr 46px;
    align-items: center;
    gap: 10px;
    font-size: 0.82rem;
  }

  .gap-list :global(.gl-name) {
    font-weight: 550;
    white-space: nowrap;
  }

  .gap-list :global(.gl-bars) {
    display: grid;
    gap: 3px;
  }

  .gap-list :global(.gl-bars span) {
    display: block;
    height: 6px;
    border-radius: 0 4px 4px 0;
    transition: width 0.6s var(--ease);
  }

  .gap-list :global(.gl-human) {
    background: var(--human);
  }

  .gap-list :global(.gl-model) {
    background: var(--model);
  }

  .gap-list :global(.gl-gap) {
    text-align: right;
    font-weight: 650;
    color: var(--ink-2);
  }

  .match-note {
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid var(--line-2);
    font-size: 0.86rem;
    color: var(--ink-2);
  }

  @media (max-width: 900px) {
    .radar-card {
      grid-template-columns: minmax(0, 1fr);
    }

    .axis-label {
      font-size: 19px;
    }

    .axis-label .kind-dot {
      font-size: 14px;
    }

    .ring-label {
      font-size: 15px;
    }
  }
</style>
