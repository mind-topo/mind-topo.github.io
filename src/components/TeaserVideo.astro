---
// TeaserVideo.astro - the launch video. Nothing loads until the reader presses play.
import Icon from './Icon.astro';
---
<section id="teaser" class="teaser-section" aria-label="Teaser video">
  <div class="wrap">
    <figure class="teaser" data-reveal>
      <div class="media-frame teaser-frame">
        <video
          id="teaser-video"
          preload="none"
          playsinline
          poster="/media/mindtopo-teaser-poster.webp"
          width="1920"
          height="1080"
          aria-label="MindTopo overview video, 1 minute 42 seconds, with music"
        >
          <source src="/media/mindtopo-teaser.mp4" type="video/mp4" />
        </video>
        <button class="play-overlay" id="teaser-play" aria-label="Play the overview video (1:42, sound on)">
          <span class="play-disc"><Icon name="play" size={30} /></span>
          <span class="play-meta"><strong>Watch the overview</strong><span><Icon name="sound" size={14} />1:42 · sound on</span></span>
        </button>
      </div>
    </figure>
  </div>
</section>

<script>
  const video = document.getElementById('teaser-video') as HTMLVideoElement | null;
  const play = document.getElementById('teaser-play');
  if (video && play) {
    play.addEventListener('click', () => {
      video.controls = true;
      video.preload = 'auto';
      play.classList.add('gone');
      video.play().catch(() => play.classList.remove('gone'));
      video.focus({ preventScroll: true });
    });
    video.addEventListener('ended', () => {
      video.controls = false;
      video.load();
      play.classList.remove('gone');
    });
  }
</script>

<style>
  .teaser-section {
    padding: 0 0 clamp(56px, 8vw, 96px);
    scroll-margin-top: calc(var(--header-h) + 16px);
  }

  .teaser {
    max-width: 1060px;
    margin: 0 auto;
  }

  .teaser-frame {
    aspect-ratio: 16 / 9;
    border-radius: 20px;
  }

  .teaser-frame video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #0c1215;
  }

  .play-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 14px;
    padding-bottom: clamp(20px, 6%, 56px);
    background: linear-gradient(180deg, transparent 45%, rgba(5, 10, 12, 0.55) 100%);
    color: #fff;
    transition: opacity 0.3s var(--ease);
  }

  .play-overlay.gone {
    opacity: 0;
    pointer-events: none;
  }

  .play-disc {
    display: grid;
    place-items: center;
    width: clamp(64px, 8vw, 84px);
    height: clamp(64px, 8vw, 84px);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.96);
    color: var(--ink);
    box-shadow: 0 12px 30px -6px rgba(0, 0, 0, 0.45);
    transition: transform 0.3s var(--ease);
  }

  .play-disc :global(svg) {
    margin-left: 4px;
  }

  .play-overlay:hover .play-disc,
  .play-overlay:focus-visible .play-disc {
    transform: scale(1.08);
  }

  .play-meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    font-size: 0.86rem;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.4);
  }

  .play-meta strong {
    font-size: 1rem;
  }

  .play-meta span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    opacity: 0.85;
  }

  /* Phones: keep the poster's title clear; a compact button sits bottom-right. */
  @media (max-width: 640px) {
    .teaser-frame {
      border-radius: 14px;
    }

    .play-overlay {
      flex-direction: row;
      align-items: flex-end;
      justify-content: flex-end;
      gap: 10px;
      padding: 0 12px 12px 0;
    }

    .play-disc {
      width: 48px;
      height: 48px;
      order: 2;
    }

    .play-disc :global(svg) {
      width: 20px;
      height: 20px;
    }

    .play-meta {
      align-items: flex-end;
      padding-bottom: 6px;
    }

    .play-meta strong {
      display: none;
    }
  }
</style>
