---
// Hero.astro - title, one-line takeaway, authors, resources and the benchmark at a glance.
import Icon from './Icon.astro';
import { FACTS } from '../data/site';

const STATS = [
  { value: FACTS.properties, label: 'topological properties' },
  { value: 2, label: 'cognitive levels' },
  { value: FACTS.tasks, label: 'procedural tasks' },
  { value: FACTS.instances, label: 'evaluation instances' },
  { value: FACTS.models, label: 'MLLMs evaluated' },
  { value: FACTS.videoModels, label: 'video generators probed' },
];
---
<section id="top" class="hero">
  <svg class="hero-loops" id="hero-loops" viewBox="0 0 1200 640" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <path class="loop loop-a" />
    <path class="loop loop-b" />
    <path class="loop loop-c" />
  </svg>

  <div class="wrap hero-inner">
    <h1 class="hero-title">
      <span class="hero-brand"><img src="/icon.png" alt="" width="56" height="56" />MindTopo</span>
      <span class="hero-question">Can Foundation Models Reason in Topological Space?</span>
    </h1>

    <p class="hero-takeaway">
      Models can <mark class="see">recognize</mark> a topological relation in a static scene, but cannot
      <mark class="act">maintain or act on it</mark> across a sequence of actions.
    </p>

    <div class="authors">
      <p class="author-line">
        <span>Yunfei Ge<sup>1*</sup></span>
        <span>Anbang Liu<sup>1*</sup></span>
        <a data-href="https://qinengwang-aiden.github.io/" class="link-disabled" aria-disabled="true">Qineng Wang<sup>1*†</sup></a>
        <span>Johnalbert Garnica<sup>1*</sup></span>
        <span>Jianwen Lyu<sup>1</sup></span>
        <a data-href="https://zihanwang314.github.io/" class="link-disabled" aria-disabled="true">Zihan Wang<sup>1</sup></a>
        <span>Reuben Tan<sup>2</sup></span>
        <span>Jianfeng Gao<sup>2</sup></span>
        <span>Ruohan Zhang<sup>1,3</sup></span>
        <span>Yining Hong<sup>3</sup></span>
        <a data-href="https://jiajunwu.com/" class="link-disabled" aria-disabled="true">Jiajun Wu<sup>3</sup></a>
        <a data-href="https://limanling.github.io/" class="link-disabled" aria-disabled="true">Manling Li<sup>1</sup></a>
      </p>
      <p class="affiliations">
        <span><sup>1</sup>Northwestern University</span>
        <span><sup>2</sup>Microsoft Research</span>
        <span><sup>3</sup>Stanford University</span>
      </p>
      <p class="contrib">*Equal contribution · †Project lead</p>
    </div>

    <div class="hero-actions">
      <a href="#teaser" class="btn btn-primary"><Icon name="play" size={16} />Watch the overview</a>
      <span class="btn is-pending" aria-disabled="true"><Icon name="paper" />Paper <span class="soon">soon</span></span>
      <a data-href="https://github.com/mll-lab-nu/MindTopo" class="btn is-pending link-disabled" aria-disabled="true"><Icon name="github" />Code <span class="soon">soon</span></a>
      <a data-href="https://huggingface.co/datasets/MLL-Lab/MindTOPO" class="btn is-pending link-disabled" aria-disabled="true"><Icon name="dataset" />Dataset <span class="soon">soon</span></a>
    </div>

    <dl class="hero-stats">
      {STATS.map((s) => (
        <div class="hero-stat">
          <dt>{s.label}</dt>
          <dd data-countup={s.value}>{s.value.toLocaleString('en-US')}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<script>
  import { animateLoops } from '../scripts/loops';
  const svg = document.getElementById('hero-loops') as SVGSVGElement | null;
  if (svg) animateLoops(svg, [
    { cx: 1070, cy: 170, r: 120, seed: 2 },
    { cx: 1130, cy: 470, r: 64, seed: 3 },
    { cx: 120, cy: 600, r: 70, seed: 1 },
  ]);
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(48px, 8vw, 96px) 0 clamp(56px, 7vw, 88px);
    text-align: center;
    background:
      radial-gradient(1100px 480px at 50% -10%, rgba(10, 127, 176, 0.07), transparent 70%),
      radial-gradient(700px 360px at 85% 30%, rgba(235, 104, 52, 0.05), transparent 70%);
  }

  .hero-loops {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .loop {
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    opacity: 0.16;
  }

  .loop-a {
    stroke: var(--reason);
  }

  .loop-b {
    stroke: var(--plan);
  }

  .loop-c {
    stroke: var(--amber);
  }

  .hero-inner {
    position: relative;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .hero-brand {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-size: clamp(1.6rem, 3.2vw, 2.3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--brand);
  }

  .hero-brand img {
    width: clamp(40px, 5vw, 56px);
    height: auto;
  }

  .hero-question {
    max-width: 900px;
    font-size: clamp(2.1rem, 5.4vw, 4rem);
    line-height: 1.05;
    font-weight: 750;
    letter-spacing: -0.035em;
    color: var(--ink);
    text-wrap: balance;
  }

  .hero-takeaway {
    max-width: 660px;
    margin: 26px auto 0;
    font-size: clamp(1.05rem, 1.7vw, 1.25rem);
    line-height: 1.55;
    color: var(--ink-2);
    text-wrap: balance;
  }

  mark {
    background: none;
    color: var(--ink);
    font-weight: 650;
    padding: 0 1px;
    background-repeat: no-repeat;
    background-size: 100% 0.32em;
    background-position: 0 88%;
  }

  mark.see {
    background-image: linear-gradient(rgba(10, 127, 176, 0.24), rgba(10, 127, 176, 0.24));
  }

  mark.act {
    background-image: linear-gradient(rgba(235, 104, 52, 0.26), rgba(235, 104, 52, 0.26));
  }

  .authors {
    max-width: 820px;
    margin: 30px auto 0;
    font-size: 0.98rem;
    color: var(--ink-2);
  }

  .author-line {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2px 16px;
    font-weight: 550;
    color: var(--ink);
  }

  .author-line a {
    color: inherit;
    text-decoration: none;
  }

  sup {
    font-size: 0.66em;
    font-weight: 500;
    color: var(--ink-3);
    margin-left: 1px;
  }

  .affiliations {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2px 18px;
    margin-top: 8px;
    font-size: 0.9rem;
  }

  .contrib {
    margin-top: 4px;
    font-size: 0.82rem;
    color: var(--ink-3);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 30px;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    max-width: 920px;
    margin: clamp(40px, 6vw, 60px) auto 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(6px);
    overflow: hidden;
  }

  .hero-stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 4px;
    padding: 18px 10px 16px;
  }

  .hero-stat + .hero-stat {
    border-left: 1px solid var(--line);
  }

  .hero-stat dd {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 750;
    letter-spacing: -0.03em;
    color: var(--ink);
    line-height: 1;
  }

  .hero-stat dt {
    font-size: 0.76rem;
    color: var(--ink-3);
    line-height: 1.3;
  }

  @media (max-width: 760px) {
    .hero-stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .hero-stat:nth-child(4) {
      border-left: 0;
    }

    .hero-stat:nth-child(n + 4) {
      border-top: 1px solid var(--line);
    }
  }
</style>
