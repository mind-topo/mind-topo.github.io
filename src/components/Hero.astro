</section> 

<script>
  // Format numbers to show 'k' for thousands
  function formatNumber(num: number): string {
    return num > 999 ? (num / 1000).toFixed(1) + 'k' : num.toString();
  }

  // Animate title characters
  function animateTitle() {
    const titleElement = document.getElementById('animated-title');
    const subtitleElement = document.querySelector('.title-subtitle');
    
    if (titleElement) {
      const text = titleElement.textContent || '';
      titleElement.innerHTML = '';
      
      // Wrap each character in a span for animation
      text.split('').forEach((char, index) => {
        const span = document.createElement('span');
        span.textContent = char === ' ' ? '\u00A0' : char; // Use non-breaking space for spaces
        span.className = 'reveal-char';
        span.style.animationDelay = `${index * 0.05}s`;
        titleElement.appendChild(span);
      });
    }
    
    // Subtitle fades in as a whole line (per-character spans break word
    // wrapping on narrow screens, since each char becomes its own inline box).
  }

  // Fetch GitHub stats directly
  async function fetchGitHubStats() {
    try {
      // Try to use default numbers immediately
      const starsElement = document.getElementById('hero-stars-count');
      const forksElement = document.getElementById('hero-forks-count');
      
      // Fetch latest stats from GitHub
      const response = await fetch('https://api.github.com/repos/mll-lab-nu/MindTopo');
      const data = await response.json();
      
      const stars = data.stargazers_count;
      const forks = data.forks_count;
      
      // Update stars count if available and different from default
      if (starsElement && stars !== undefined) {
        const formattedStars = formatNumber(stars);
        if (formattedStars !== '1.4k') {
          starsElement.textContent = formattedStars;
        }
      }
      
      // Update forks count if available and different from default
      if (forksElement && forks !== undefined) {
        const formattedForks = formatNumber(forks);
        if (formattedForks !== '105') {
          forksElement.textContent = formattedForks;
        }
      }
    } catch (error) {
      console.error('Error fetching GitHub stats:', error);
      // Keep default values on error
    }
  }

  // Run when page is loaded
  document.addEventListener('DOMContentLoaded', () => {
    animateTitle();
    fetchGitHubStats();
  });
</script> 

<style>
  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 12px 24px;
    background: linear-gradient(45deg, var(--brand-deep), var(--brand-mid-2));
    border: none;
    border-radius: 50px;
    color: white;
    font-size: 18px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(var(--brand-deep-rgb), 0.2);
  }

  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(var(--brand-deep-rgb), 0.3);
    text-decoration: none;
  }

  .button-icon {
    width: 24px;
    height: 24px;
    fill: currentColor;
  }

  .button-text {
    margin-right: 12px;
  }

  .repo-stats {
    display: flex;
    gap: 16px;
    padding-left: 16px;
    border-left: 1px solid rgba(255, 255, 255, 0.3);
  }

  .stat-item {
    display: flex;
    align-items: center;
    gap: 6px;
    color: white;
    font-size: 16px;
  }

  .stat-item svg {
    fill: currentColor;
  }

  .main-subtitle {
    max-width: 800px;
    margin: 20px auto 0;
    color: #555;
    font-size: 18px;
    line-height: 1.6;
    text-align: center;
    font-weight: 400;
  }

  .vagen-announcement {
    color: var(--brand-deep);
    font-size: 0.9em;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .vagen-announcement:hover {
    color: var(--brand-mid-2);
    text-decoration: none;
  }

  .highlight-phrase {
    color: var(--brand-deep);
  }

  /* Teaser figure */
  .teaser-image {
    width: 100%;
    max-width: 100%;
    height: auto;
    display: block;
    border-radius: 12px;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.8s ease-out 0.3s forwards;
  }

  /* Benchmark at a glance */
  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin: 2.5rem auto 0;
    max-width: 900px;
  }

  .hero-stat {
    flex: 1 1 150px;
    min-width: 130px;
    background-color: #f8f9fa;
    border: 1px solid #e9ecef;
    border-radius: 12px;
    padding: 1rem 0.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .hero-stat.highlight {
    background: linear-gradient(135deg, #e8f4f7 0%, var(--brand-tint-2) 100%);
    border-color: var(--brand-tint-border);
  }

  .hero-stat-value {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--brand-deep);
    line-height: 1;
  }

  .hero-stat-value .unit {
    font-size: 1.1rem;
    font-weight: 700;
  }

  .hero-stat-label {
    font-size: 0.8rem;
    color: #6b7280;
    text-align: center;
    line-height: 1.35;
  }

  /* Disabled resource button (paper not public yet) */
  .resources-buttons .resource-button.disabled {
    opacity: 0.55;
    cursor: default;
    pointer-events: none;
  }

  @media (max-width: 480px) {
    .hero-stat {
      flex-basis: 45%;
      min-width: 0;
    }

    .hero-stat-value {
      font-size: 1.4rem;
    }
  }
</style>
