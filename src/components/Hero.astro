---
// Hero.astro - title, one-line takeaway, authors, resources and the benchmark at a glance.
import Icon from './Icon.astro';
import { FACTS } from '../data/site';
import { AUTHORS, AFFILIATIONS, LINKS, VENUE } from '../data/people';

const STATS = [
  { value: FACTS.properties, label: 'topological properties' },
  { value: 2, label: 'cognitive levels' },
  { value: FACTS.tasks, label: 'procedural tasks' },
  { value: FACTS.instances, label: 'Core instances' },
  { value: FACTS.models, label: 'MLLMs evaluated' },
  { value: FACTS.videoModels, label: 'video generators probed' },
];
const marks = (a: (typeof AUTHORS)[number]) => `${a.affil.join(',')}${a.equal ? '*' : ''}${a.lead ? '†' : ''}`;
---
<section id="top" class="hero">
  <div class="hero-pegs" aria-hidden="true"></div>

  <div class="wrap hero-inner">
    <p class="venue"><span class="venue-dot" aria-hidden="true"></span>{VENUE}</p>

    <h1 class="hero-title">
      <span class="hero-brand"><img src="/icon.png" alt="" width="56" height="56" />MindTopo</span>
      <span class="hero-question">Can Foundation Models Reason in Topological Space?</span>
    </h1>

    <p class="hero-takeaway">
      Models can <mark class="see">recognize</mark> topological relations in static scenes, but struggle to
      <mark class="act">maintain or act on them reliably</mark> across a sequence of actions.
    </p>

    <div class="authors">
      <p class="author-line">
        {AUTHORS.map((a) => (
          <a href={a.url} target="_blank" rel="noopener">{a.name}<sup>{marks(a)}</sup></a>
        ))}
      </p>
      <p class="affiliations">
        {AFFILIATIONS.map((name, i) => <span><sup>{i + 1}</sup>{name}</span>)}
        <span class="contrib">*Equal contribution · †Project lead</span>
      </p>
    </div>

    <div class="hero-actions">
      <a href="#play" class="btn btn-primary"><Icon name="play" size={16} />Play the games</a>
      <a href={LINKS.paper} class="btn" target="_blank" rel="noopener"><Icon name="paper" />Current paper</a>
      <a href={LINKS.code} class="btn" target="_blank" rel="noopener"><Icon name="github" />Code</a>
      <a href={LINKS.release} class="btn"><Icon name="dataset" />Core &amp; Extended</a>
    </div>

    <dl class="hero-stats">
      {STATS.map((s) => (
        <div class="hero-stat">
          <dt>{s.label}</dt>
          <dd data-countup={s.value}>{s.value.toLocaleString('en-US')}</dd>
        </div>
      ))}
    </dl>
    <p class="split-note">
      The Extended Set adds <strong>{FACTS.extendedInstances.toLocaleString('en-US')}</strong> instances with no
      exact-input overlap with the Core Set. <a href={LINKS.release}>Explore both sets and download the manifests.</a>
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(48px, 8vw, 96px) 0 clamp(56px, 7vw, 88px);
    text-align: center;
    background:
      radial-gradient(1100px 480px at 50% -10%, rgba(10, 127, 176, 0.07), transparent 70%),
      radial-gradient(700px 360px at 85% 30%, rgba(235, 104, 52, 0.05), transparent 70%);
  }

  /* A faint peg board (the Untangle / Chat Noir grids) that fades out toward the edges. */
  .hero-pegs {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(circle, rgba(20, 80, 94, 0.2) 1.4px, transparent 1.8px);
    background-size: 28px 28px;
    background-position: center top;
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 38%, #000 10%, transparent 75%);
    mask-image: radial-gradient(ellipse 70% 60% at 50% 38%, #000 10%, transparent 75%);
  }

  .venue {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 22px;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.85);
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--ink-2);
  }

  .venue-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--plan);
    box-shadow: 0 0 0 3px rgba(235, 104, 52, 0.18);
  }

  .hero-inner {
    position: relative;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .hero-brand {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-size: clamp(1.6rem, 3.2vw, 2.3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--brand);
  }

  .hero-brand img {
    width: clamp(40px, 5vw, 56px);
    height: auto;
  }

  .hero-question {
    max-width: 900px;
    font-size: clamp(2.1rem, 5.4vw, 4rem);
    line-height: 1.05;
    font-weight: 750;
    letter-spacing: -0.035em;
    color: var(--ink);
    text-wrap: balance;
  }

  .hero-takeaway {
    max-width: 660px;
    margin: 26px auto 0;
    font-size: clamp(1.05rem, 1.7vw, 1.25rem);
    line-height: 1.55;
    color: var(--ink-2);
    text-wrap: balance;
  }

  mark {
    background: none;
    color: var(--ink);
    font-weight: 650;
    padding: 0 1px;
    background-repeat: no-repeat;
    background-size: 100% 0.32em;
    background-position: 0 88%;
  }

  mark.see {
    background-image: linear-gradient(rgba(10, 127, 176, 0.24), rgba(10, 127, 176, 0.24));
  }

  mark.act {
    background-image: linear-gradient(rgba(235, 104, 52, 0.26), rgba(235, 104, 52, 0.26));
  }

  .authors {
    max-width: 820px;
    margin: 30px auto 0;
    font-size: 0.98rem;
    color: var(--ink-2);
  }

  .author-line {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2px 16px;
    font-weight: 550;
    color: var(--ink);
  }

  .author-line a {
    color: inherit;
    text-decoration: none;
    border-radius: 4px;
    transition: color 0.15s;
  }

  .author-line a:hover {
    color: var(--link);
    text-decoration: underline;
    text-decoration-color: rgba(11, 106, 146, 0.35);
  }

  sup {
    font-size: 0.66em;
    font-weight: 500;
    color: var(--ink-3);
    margin-left: 1px;
  }

  .affiliations {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2px 18px;
    margin-top: 8px;
    font-size: 0.9rem;
  }

  .contrib {
    color: var(--ink-3);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 30px;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    max-width: 920px;
    margin: clamp(40px, 6vw, 60px) auto 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(6px);
    overflow: hidden;
  }

  .hero-stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 4px;
    padding: 18px 10px 16px;
  }

  .hero-stat + .hero-stat {
    border-left: 1px solid var(--line);
  }

  .hero-stat dd {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 750;
    letter-spacing: -0.03em;
    color: var(--ink);
    line-height: 1;
  }

  .hero-stat dt {
    font-size: 0.76rem;
    color: var(--ink-3);
    line-height: 1.3;
  }

  .split-note {
    margin: 14px auto 0;
    color: var(--ink-3);
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .split-note strong {
    color: var(--ink-2);
    font-weight: 700;
  }

  @media (max-width: 760px) {
    .hero-stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .hero-stat:nth-child(4) {
      border-left: 0;
    }

    .hero-stat:nth-child(n + 4) {
      border-top: 1px solid var(--line);
    }
  }
</style>
