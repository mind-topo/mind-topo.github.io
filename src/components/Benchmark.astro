---
// Benchmark.astro - what MindTopo tests: the invariance idea, the two levels, and
// an explorer with one card per task, grouped by topological property.
import SectionHeader from './SectionHeader.astro';
import Icon from './Icon.astro';
import { PROPERTIES, TASKS, TASK_DETAILS, MODELS, HUMAN, FACTS, taskIndex, fmt } from '../data/site';

const bestAt = (task: string, level: 'easy' | 'hard') => {
  const i = taskIndex(task);
  return MODELS.reduce((a, m) => (m.scores[level]![i] > a.score ? { score: m.scores[level]![i], name: m.name } : a), { score: -1, name: '' });
};

const cards = (property: string) =>
  TASKS.filter((t) => t.property === property)
    .sort((a, b) => (a.kind === b.kind ? 0 : a.kind === 'reasoning' ? -1 : 1))
    .map((t) => ({
      ...t,
      detail: TASK_DETAILS[t.name],
      human: HUMAN.scores.easy![taskIndex(t.name)],
      easy: bestAt(t.name, 'easy'),
      hard: bestAt(t.name, 'hard'),
    }));
---
<section id="benchmark" class="section tinted">
  <div class="wrap">
    <SectionHeader id="benchmark" title="Five topological properties, each tested by seeing and by doing">
      Topology is what survives continuous deformation. Every property gets a <strong>reasoning</strong> task
      (answer a question about a rendered scene) and a <strong>planning</strong> task (act, step by step, in an
      interactive gym).
    </SectionHeader>

    <div class="intro-grid">
      <figure class="card invariance" data-reveal>
        <div class="inv-stage" id="inv-stage">
          <svg viewBox="0 0 360 240" id="inv-svg" role="img" aria-labelledby="inv-title">
            <title id="inv-title">A closed loop that keeps changing shape while a dot stays inside it.</title>
            <path id="inv-loop" class="inv-loop" />
            <circle cx="180" cy="120" r="7" class="inv-dot" />
          </svg>
          <span class="inv-hint">Move your pointer here to bend it</span>
        </div>
        <dl class="inv-readout">
          <div><dt>Perimeter</dt><dd class="tabular" id="inv-perimeter">–</dd><span class="inv-tag changes">changes</span></div>
          <div><dt>Area</dt><dd class="tabular" id="inv-area">–</dd><span class="inv-tag changes">changes</span></div>
          <div><dt>Dot inside?</dt><dd>Yes</dd><span class="inv-tag holds">invariant</span></div>
          <div><dt>Loop closed?</dt><dd>Yes</dd><span class="inv-tag holds">invariant</span></div>
        </dl>
        <figcaption class="caption">Metric properties change under deformation. Topological ones do not. MindTopo asks whether models track the second kind.</figcaption>
      </figure>

      <div class="levels" data-reveal style="--reveal-delay:.08s">
        <div class="level card">
          <span class="kind-tag reasoning">Reasoning</span>
          <p class="level-title">Identify or predict a relation</p>
          <p class="level-formula"><span>scene</span> + <span>question</span> → <span>answer</span></p>
          <p class="level-note">{FACTS.reasoningQuestions.toLocaleString('en-US')} questions · exact-match scoring</p>
        </div>
        <div class="level card">
          <span class="kind-tag planning">Planning</span>
          <p class="level-title">Act on it, in a closed loop</p>
          <p class="level-formula"><span>observe</span> → <span>act</span> → <span>observe</span> → … → <span>goal?</span></p>
          <p class="level-note">{FACTS.planningEpisodes.toLocaleString('en-US')} episodes · success only if the goal state is reached</p>
        </div>
        <p class="levels-foot">
          {FACTS.tasks} tasks × {FACTS.perTask} instances ({FACTS.perLevel} Easy + {FACTS.perLevel} Hard) =
          <strong>{FACTS.instances.toLocaleString('en-US')}</strong>. Generators can produce more: an
          {FACTS.generatorPool.toLocaleString('en-US')}-instance pool ships with the public release.
        </p>
      </div>
    </div>

    <div class="explorer" data-reveal>
      <div class="explorer-head">
        <p class="subhead">Explore the 13 tasks</p>
        <p class="subhead-note">Try the questions yourself, then compare with humans and the best model.</p>
      </div>

      <div class="prop-tabs" role="tablist" aria-label="Topological property">
        {PROPERTIES.map((p, i) => (
          <button
            role="tab"
            id={`tab-${p.id}`}
            aria-controls={`panel-${p.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="prop-tab"
          >
            <span class="prop-name">{p.name}</span>
            <span class="prop-q">{p.question}</span>
          </button>
        ))}
      </div>

      {PROPERTIES.map((p, i) => (
        <div
          class="prop-panel"
          role="tabpanel"
          id={`panel-${p.id}`}
          aria-labelledby={`tab-${p.id}`}
          hidden={i !== 0}
          data-cards={cards(p.id).length}
        >
          {cards(p.id).map((t) => (
            <article class={`task-card ${t.kind}`}>
              <header class="task-head">
                <h3>{t.name}</h3>
                <span class={`kind-tag ${t.kind}`}>{t.kind === 'reasoning' ? 'Reasoning' : 'Planning · gym'}</span>
              </header>

              {t.detail.media.length > 1 ? (
                <div class="stepper" data-stepper>
                  <div class="stepper-frames">
                    {t.detail.media.map((m, k) => (
                      <img src={m.src} width={m.width} height={m.height} alt={`${t.name}, ${m.label?.toLowerCase()} state`} loading="lazy" decoding="async" class={k === 0 ? 'on' : ''} />
                    ))}
                  </div>
                  <div class="stepper-bar">
                    <button class="stepper-toggle" aria-label="Pause the animation" data-playing="true">
                      <Icon name="pause" size={14} class="i-pause" /><Icon name="play" size={14} class="i-play" />
                    </button>
                    <div class="stepper-steps">
                      {t.detail.media.map((m, k) => (
                        <button class={`step ${k === 0 ? 'on' : ''}`} data-step={k} aria-label={`Show ${m.label} state`}>
                          <span class="step-fill"></span><span class="step-label">{m.label}</span>
                        </button>
                      ))}
                    </div>
                  </div>
                </div>
              ) : (
                <div class="task-media">
                  <img src={t.detail.media[0].src} width={t.detail.media[0].width} height={t.detail.media[0].height} alt={`${t.name} example scene`} loading="lazy" decoding="async" />
                </div>
              )}

              <p class="task-prompt">{t.kind === 'reasoning' ? 'Q: ' : 'Goal: '}{t.detail.prompt}</p>

              {t.detail.options ? (
                <div class={`mcq ${t.detail.options[0].image ? 'mcq-images' : ''}`} role="group" aria-label={`${t.name} answer options`}>
                  {t.detail.options.map((o) => (
                    <button class="mcq-option" data-correct={o.correct ? 'true' : 'false'}>
                      {o.image ? <img src={o.image} alt={`Option ${o.label}`} width="720" height="274" loading="lazy" /> : null}
                      <span>{o.image ? `Option ${o.label}` : o.label}</span>
                    </button>
                  ))}
                  <p class="mcq-feedback" aria-live="polite"></p>
                </div>
              ) : t.detail.answer ? (
                <div class="reveal">
                  <button class="reveal-btn" aria-expanded="false">Reveal answer</button>
                  <p class="reveal-answer" hidden>Answer: <strong>{t.detail.answer}</strong></p>
                </div>
              ) : null}

              <dl class="task-stats">
                <div class="ts-row">
                  <dt>Human · Easy</dt>
                  <dd><span class="ts-bar human" style={`--v:${t.human}%`}></span><span class="tabular">{fmt(t.human)}</span></dd>
                </div>
                <div class="ts-row" title={t.easy.name}>
                  <dt>Best model · Easy</dt>
                  <dd><span class="ts-bar" style={`--v:${t.easy.score}%`}></span><span class="tabular">{fmt(t.easy.score)}</span></dd>
                </div>
                <div class="ts-row" title={t.hard.name}>
                  <dt>Best model · Hard</dt>
                  <dd><span class="ts-bar" style={`--v:${t.hard.score}%`}></span><span class="tabular">{fmt(t.hard.score)}</span></dd>
                </div>
              </dl>
            </article>
          ))}
        </div>
      ))}
    </div>

    <figure class="pipeline card" data-reveal>
      <div class="pipeline-head">
        <p class="subhead">Fully automated generation</p>
        <p class="subhead-note">Scene generation → topological annotation from the scene state → difficulty control → instance export, with fixed seeds and task-specific acceptance checks.</p>
      </div>
      <img src="/media/figures/pipeline.webp" width="2200" height="670" alt="The four-stage MindTopo data pipeline: scene generation, topological annotation, difficulty control (Easy vs Hard), and instance generation for reasoning and planning tasks." loading="lazy" decoding="async" />
    </figure>
  </div>
</section>

<script>
  import { initBenchmark } from '../scripts/benchmark';
  initBenchmark();
</script>

<style>
  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 20px;
    margin-bottom: clamp(40px, 6vw, 64px);
  }

  /* Invariance demo */
  .invariance {
    padding: 18px 18px 16px;
  }

  .inv-stage {
    position: relative;
    border-radius: 12px;
    background:
      radial-gradient(circle at 1px 1px, #dfe6e8 1px, transparent 1.2px) 0 0 / 18px 18px,
      var(--surface-2);
    touch-action: pan-y;
    cursor: crosshair;
  }

  .inv-stage svg {
    width: 100%;
    height: auto;
  }

  .inv-loop {
    fill: rgba(10, 127, 176, 0.08);
    stroke: var(--reason);
    stroke-width: 2.5;
    stroke-linejoin: round;
  }

  .inv-dot {
    fill: var(--plan);
    stroke: var(--surface);
    stroke-width: 2;
  }

  .inv-hint {
    position: absolute;
    left: 12px;
    bottom: 10px;
    font-size: 0.74rem;
    color: var(--ink-3);
    transition: opacity 0.3s;
  }

  .inv-stage.touched .inv-hint {
    opacity: 0;
  }

  .inv-readout {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    margin-top: 14px;
  }

  .inv-readout > div {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 10px 8px;
    border-radius: 10px;
    background: var(--surface-2);
  }

  .inv-readout dt {
    font-size: 0.72rem;
    color: var(--ink-3);
  }

  .inv-readout dd {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .inv-tag {
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .inv-tag.changes {
    color: #a63f14;
  }

  .inv-tag.holds {
    color: #075b80;
  }

  /* Two levels */
  .levels {
    display: grid;
    gap: 14px;
    align-content: start;
  }

  .level {
    padding: 20px 22px;
  }

  .level-title {
    margin-top: 10px;
    font-size: 1.1rem;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .level-formula {
    margin-top: 10px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-size: 0.86rem;
    color: var(--ink-3);
  }

  .level-formula span {
    padding: 3px 10px;
    border-radius: 8px;
    background: var(--surface-2);
    color: var(--ink);
    font-weight: 550;
  }

  .level-note {
    margin-top: 10px;
    font-size: 0.84rem;
    color: var(--ink-3);
  }

  .levels-foot {
    font-size: 0.88rem;
    color: var(--ink-2);
    padding: 0 4px;
  }

  /* Explorer */
  .explorer-head {
    margin-bottom: 16px;
  }

  .prop-tabs {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 8px;
    margin-bottom: 18px;
  }

  .prop-tab {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    padding: 12px 14px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--page);
    text-align: left;
    transition: border-color 0.2s, background-color 0.2s, box-shadow 0.2s;
  }

  .prop-tab:hover {
    border-color: #c9d4d8;
    background: var(--surface);
  }

  .prop-tab[aria-selected='true'] {
    background: var(--surface);
    border-color: var(--ink);
    box-shadow: inset 0 -3px 0 var(--ink);
  }

  .prop-name {
    font-weight: 650;
    font-size: 0.98rem;
  }

  .prop-q {
    font-size: 0.78rem;
    color: var(--ink-3);
    line-height: 1.3;
  }

  .prop-panel {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    animation: panel-in 0.4s var(--ease);
  }

  .prop-panel[data-cards='2'] {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .prop-panel[hidden] {
    display: none;
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  .task-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface);
    border-top: 3px solid var(--reason);
  }

  .task-card.planning {
    border-top-color: var(--plan);
  }

  .task-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .task-head h3 {
    font-size: 1.08rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  /* One 4:3 frame for every task image keeps the cards in a steady rhythm. */
  .task-media,
  .stepper-frames {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 10px;
    background: var(--surface-2);
  }

  .task-media img,
  .stepper-frames img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .stepper-frames img {
    opacity: 0;
    transition: opacity 0.6s var(--ease);
  }

  .stepper-frames img.on {
    opacity: 1;
  }

  .stepper-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 8px;
  }

  .stepper-toggle {
    display: grid;
    place-items: center;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1px solid var(--line);
    color: var(--ink-2);
  }

  .stepper-toggle:hover {
    color: var(--ink);
    border-color: #c9d4d8;
  }

  .stepper-toggle :global(.i-play),
  .stepper-toggle[data-playing='false'] :global(.i-pause) {
    display: none;
  }

  .stepper-toggle[data-playing='false'] :global(.i-play) {
    display: block;
  }

  .stepper-steps {
    flex: 1;
    display: flex;
    gap: 6px;
  }

  .step {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 4px 0;
    text-align: left;
  }

  .step::before {
    content: '';
    display: block;
    height: 3px;
    border-radius: 3px;
    background: var(--line);
  }

  .step-fill {
    display: none;
  }

  .step.on::before {
    background: var(--ink);
  }

  .step-label {
    font-size: 0.72rem;
    color: var(--ink-3);
  }

  .step.on .step-label {
    color: var(--ink);
    font-weight: 600;
  }

  .task-prompt {
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--ink);
    font-weight: 500;
  }

  .reveal-btn {
    min-height: 34px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px dashed #b9c6ca;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink-2);
  }

  .reveal-btn:hover {
    border-style: solid;
    color: var(--ink);
  }

  .reveal-answer {
    font-size: 0.9rem;
    color: var(--ink-2);
    animation: panel-in 0.35s var(--ease);
  }

  .mcq {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .mcq-images {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .mcq-option {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    min-height: 32px;
    padding: 4px 12px;
    border-radius: 10px;
    border: 1px solid var(--line);
    font-size: 0.8rem;
    font-weight: 550;
    color: var(--ink-2);
    transition: border-color 0.2s, background-color 0.2s, color 0.2s;
  }

  .mcq-images .mcq-option {
    padding: 4px;
  }

  .mcq-option img {
    border-radius: 6px;
  }

  .mcq-option:hover {
    border-color: #b9c6ca;
    color: var(--ink);
  }

  .mcq-option.right {
    border-color: #0ca30c;
    background: #ecf8ec;
    color: #0a5c0a;
  }

  .mcq-option.wrong {
    border-color: #d03b3b;
    background: #fcefef;
    color: #8f2323;
  }

  .mcq-feedback {
    flex-basis: 100%;
    grid-column: 1 / -1;
    font-size: 0.84rem;
    color: var(--ink-2);
    min-height: 1.3em;
  }

  .task-stats {
    display: grid;
    gap: 5px;
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--line-2);
  }

  .ts-row {
    display: grid;
    grid-template-columns: 112px 1fr;
    align-items: center;
    gap: 8px;
    font-size: 0.76rem;
  }

  .ts-row dt {
    color: var(--ink-3);
  }

  .ts-row dd {
    display: grid;
    grid-template-columns: 1fr 34px;
    align-items: center;
    gap: 8px;
    text-align: right;
    font-weight: 600;
  }

  .ts-bar {
    position: relative;
    height: 6px;
    border-radius: 6px;
    background: var(--line-2);
    overflow: hidden;
  }

  .ts-bar::after {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--v);
    border-radius: 6px;
    background: var(--reason);
    transform-origin: 0 50%;
    transition: transform 0.9s var(--ease);
  }

  .planning .ts-bar::after {
    background: var(--plan);
  }

  .ts-bar.human::after {
    background: var(--human);
  }

  .js .prop-panel:not(.drawn) .ts-bar::after {
    transform: scaleX(0);
  }

  /* Pipeline */
  .pipeline {
    margin-top: clamp(40px, 6vw, 64px);
    padding: clamp(18px, 2.6vw, 28px);
  }

  .pipeline-head {
    margin-bottom: 18px;
    max-width: 760px;
  }

  .pipeline img {
    width: 100%;
    border-radius: 10px;
  }

  @media (max-width: 980px) {
    .intro-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .prop-tabs {
      grid-template-columns: repeat(5, minmax(140px, 1fr));
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 4px;
    }

    .prop-tab {
      scroll-snap-align: start;
    }

    .prop-panel,
    .prop-panel[data-cards='2'] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .prop-panel,
    .prop-panel[data-cards='2'] {
      grid-template-columns: minmax(0, 1fr);
    }

    .inv-readout {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
