---
// Header.astro - slim sticky bar: brand, resource links, and (below 1200px) the section menu.
import Icon from './Icon.astro';
import { SECTIONS } from '../data/nav';
import { LINKS } from '../data/people';
---
<header class="site-header" id="site-header">
  <div class="header-inner">
    <a href="#top" class="brand" aria-label="MindTopo, back to top">
      <img src="/icon.png" alt="" width="28" height="28" />
      <span>MindTopo</span>
    </a>

    <nav class="header-links" aria-label="Resources">
      <a href={LINKS.paper} class="header-link" target="_blank" rel="noopener"><Icon name="paper" size={16} />Paper</a>
      <a href={LINKS.code} class="header-link" target="_blank" rel="noopener"><Icon name="github" size={16} />Code</a>
      <a href={LINKS.dataset} class="header-link" target="_blank" rel="noopener"><Icon name="dataset" size={16} />Data</a>
      <a href="#citation" class="header-link cite-link">Cite</a>
    </nav>

    <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="mobile-nav">
      <span class="nav-toggle-label" id="nav-toggle-label">Sections</span>
      <Icon name="menu" size={18} class="icon-open" />
      <Icon name="close" size={18} class="icon-close" />
    </button>
  </div>
  <div class="read-progress" aria-hidden="true"><span id="read-progress-bar"></span></div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Sections" hidden>
    <ol>
      {SECTIONS.map((s, i) => (
        <li>
          <a href={`#${s.id}`} data-nav-link={s.id} data-label={s.label}>
            <span class="mobile-num">{String(i).padStart(2, '0')}</span>{s.label}
          </a>
        </li>
      ))}
    </ol>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--header-h);
    background: rgba(246, 248, 248, 0.82);
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s, background-color 0.25s;
  }

  :global(.is-scrolled) .site-header {
    border-bottom-color: var(--line);
  }

  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 0 clamp(16px, 3vw, 28px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 1.02rem;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
    border-radius: 8px;
  }

  .brand img {
    width: 28px;
    height: 28px;
  }

  .header-links {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
  }

  .header-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    padding: 0 12px;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 550;
    color: var(--ink-2);
    text-decoration: none;
    transition: background-color 0.2s, color 0.2s;
  }

  .header-link:hover {
    background: var(--surface-2);
    color: var(--ink);
  }

  .read-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    pointer-events: none;
  }

  .read-progress span {
    display: block;
    height: 100%;
    width: 100%;
    background: linear-gradient(90deg, var(--reason), var(--brand-2));
    transform-origin: 0 50%;
    transform: scaleX(0);
  }

  .nav-toggle {
    display: none;
    align-items: center;
    gap: 8px;
    min-height: 38px;
    padding: 0 12px 0 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .nav-toggle-label {
    max-width: 9.5rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .nav-toggle :global(.icon-close) {
    display: none;
  }

  .nav-toggle[aria-expanded='true'] :global(.icon-open) {
    display: none;
  }

  .nav-toggle[aria-expanded='true'] :global(.icon-close) {
    display: block;
  }

  .mobile-nav {
    position: absolute;
    top: calc(100% + 8px);
    right: 12px;
    width: min(320px, calc(100vw - 24px));
    max-height: calc(100vh - var(--header-h) - 24px);
    overflow-y: auto;
    padding: 8px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
    box-shadow: var(--shadow-2);
    animation: drop-in 0.22s var(--ease);
  }

  .mobile-nav ol {
    list-style: none;
  }

  .mobile-nav a {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 0 12px;
    border-radius: 10px;
    color: var(--ink-2);
    font-weight: 550;
    text-decoration: none;
  }

  .mobile-nav a:hover {
    background: var(--surface-2);
    color: var(--ink);
  }

  .mobile-nav a[aria-current='true'] {
    background: var(--brand-tint);
    color: var(--brand);
  }

  .mobile-num {
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink-3);
  }

  @keyframes drop-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  @media (max-width: 1199px) {
    .nav-toggle {
      display: inline-flex;
    }
  }

  @media (max-width: 720px) {
    .header-link:not(.cite-link) {
      display: none;
    }
  }

  @media (max-width: 380px) {
    .nav-toggle-label {
      display: none;
    }
  }
</style>
