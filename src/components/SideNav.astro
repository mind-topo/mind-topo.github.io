---
// SideNav.astro - fixed table of contents in the left gutter (>= 1200px).
// The track fills with reading progress and the current section is marked by
// src/scripts/site.ts. Below 1200px the same list lives in the header menu.
import Icon from './Icon.astro';
import { SECTIONS } from '../data/nav';
---
<nav class="side-nav" aria-label="Sections">
  <div class="track" aria-hidden="true"><span id="side-nav-fill"></span></div>
  <ol>
    {SECTIONS.map((s) => (
      <li>
        <a href={`#${s.id}`} data-nav-link={s.id} data-label={s.label}>
          <span class="dot" aria-hidden="true"></span>
          <span class="label">{s.label}</span>
        </a>
      </li>
    ))}
  </ol>
  <a href="#top" class="to-top" id="to-top">
    <Icon name="arrow-up" size={14} />Back to top
  </a>
</nav>

<style>
  .side-nav {
    display: none;
  }

  @media (min-width: 1200px) {
    .side-nav {
      display: block;
      position: fixed;
      z-index: 30;
      top: calc(var(--header-h) + 40px);
      left: max(16px, calc(50% - var(--col) / 2 + var(--col-shift) - var(--nav-w) - var(--nav-gap)));
      width: var(--nav-w);
    }
  }

  ol {
    list-style: none;
    position: relative;
  }

  .track {
    position: absolute;
    left: 5px;
    top: 14px;
    bottom: 58px;
    width: 2px;
    border-radius: 2px;
    background: var(--line);
    overflow: hidden;
  }

  .track span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--brand-2);
    transform-origin: 50% 0;
    transform: scaleY(0);
  }

  a[data-nav-link] {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 34px;
    padding: 2px 8px 2px 0;
    color: var(--ink-3);
    font-size: 0.86rem;
    font-weight: 500;
    line-height: 1.25;
    text-decoration: none;
    border-radius: 8px;
    transition: color 0.2s;
  }

  a[data-nav-link]:hover {
    color: var(--ink);
  }

  .dot {
    flex: none;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--page);
    border: 2px solid #c8d2d6;
    transition: border-color 0.25s, background-color 0.25s, transform 0.25s var(--ease);
  }

  a[data-nav-link]:hover .dot {
    border-color: var(--ink-3);
  }

  a[data-nav-link].is-past .dot {
    border-color: var(--brand-2);
  }

  a[aria-current='true'] {
    color: var(--ink);
    font-weight: 650;
  }

  a[aria-current='true'] .dot {
    background: var(--brand-2);
    border-color: var(--brand-2);
    transform: scale(1.15);
    box-shadow: 0 0 0 4px rgba(30, 110, 128, 0.14);
  }

  .to-top {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 18px;
    padding: 6px 10px 6px 0;
    font-size: 0.78rem;
    font-weight: 550;
    color: var(--ink-3);
    text-decoration: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s, visibility 0.25s, color 0.2s;
  }

  .to-top.show {
    opacity: 1;
    visibility: visible;
  }

  .to-top:hover {
    color: var(--ink);
  }
</style>
