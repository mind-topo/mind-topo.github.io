---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import TeaserVideo from '../components/TeaserVideo.astro';
import Findings from '../components/Findings.astro';
import Play from '../components/Play.astro';
import Results from '../components/Results.astro';
import Release from '../components/Release.astro';
import Humans from '../components/Humans.astro';
import Training from '../components/Training.astro';
import Errors from '../components/Errors.astro';
import Imagination from '../components/Imagination.astro';
import Citation from '../components/Citation.astro';
import { AUTHORS, LINKS } from '../data/people';
// Hidden components (DatasetViewer, FindingsSection, TrajectoryViewer) are kept in
// src/components but predate the 2026-11 redesign; see the README before re-enabling.

const pageTitle = 'MindTopo: Can Foundation Models Reason in Topological Space?';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ScholarlyArticle',
      headline: pageTitle,
      name: pageTitle,
      url: 'https://mind-topo.github.io/',
      datePublished: '2026-09-10',
      dateModified: '2026-11-08',
      image: 'https://mind-topo.github.io/og-card.jpg',
      abstract:
        'Spatial reasoning depends not only on metric properties such as distance, angle, and shape, but also on topological relations that remain invariant under continuous deformation. MindTopo is a benchmark of topological intuition across five properties grounded in cognitive science and formal topology: continuity, separation, order, enclosure, and knots. Each property is evaluated at two cognitive levels: reasoning, where a model identifies a topological relation or infers how it changes, and planning, where a foundation model acts as a closed-loop agent in an interactive environment. The primary 3,900-instance Core Set spans 13 procedurally generated task types with controllable difficulty, split into an Easy and a Hard level; the companion Extended Set adds 8,780 exact-input-disjoint instances. Across 13 MLLMs, every model performs better on reasoning than on planning. On the Easy level, where human scores are available, even the strongest model trails humans. Supervised fine-tuning and reinforcement learning improve reasoning more than planning, and seven video generative models reach plausible endpoints without preserving valid topological transitions.',
      keywords:
        'MindTopo, topological reasoning, topological intuition, topology benchmark, spatial reasoning, multimodal large language models, MLLM, foundation models, video generation, world model, planning, Piaget, continuity, separation, order, enclosure, knots',
      author: AUTHORS.map((a) => ({ '@type': 'Person', name: a.name, url: a.url })),
      sameAs: [LINKS.arxiv],
      encoding: { '@type': 'MediaObject', contentUrl: LINKS.pdf, encodingFormat: 'application/pdf' },
    },
    {
      '@type': 'Dataset',
      name: 'MindTopo',
      description:
        'A topological reasoning benchmark with a 3,900-instance Core Set across 13 task types and five topological properties (continuity, separation, order, enclosure, knots), comprising 2,400 reasoning questions over rendered scenes and 1,500 interactive planning episodes, split evenly between an Easy and a Hard level. An additional 8,780-instance Extended Set has no exact-input overlap with the Core Set.',
      url: 'https://mind-topo.github.io/',
      sameAs: [LINKS.dataset, LINKS.code],
      creator: { '@type': 'Organization', name: 'MLL Lab, Northwestern University' },
      distribution: ['core', 'extended'].map((split) => ({
        '@type': 'DataDownload',
        name: `${split === 'core' ? 'Core' : 'Extended'} input manifest`,
        contentUrl: `https://mind-topo.github.io/release/${split}_manifest.jsonl.gz`,
        encodingFormat: 'application/gzip',
      })),
      keywords: 'MindTopo, topological reasoning, topology benchmark, spatial reasoning, MLLM, planning, connectivity, enclosure, knots',
    },
    {
      '@type': 'SoftwareSourceCode',
      name: 'MindTopo',
      codeRepository: LINKS.code,
      programmingLanguage: 'Python',
    },
    { '@type': 'WebSite', name: 'MindTopo', url: 'https://mind-topo.github.io/' },
  ],
};
---
<Layout title={pageTitle}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    {/* Google Scholar (Highwire Press) tags. */}
    <meta name="citation_title" content={pageTitle} />
    {AUTHORS.map((a) => <meta name="citation_author" content={a.name} />)}
    <meta name="citation_publication_date" content="2026" />
    <meta name="citation_arxiv_id" content={LINKS.arxivId} />
    <meta name="citation_pdf_url" content={LINKS.pdf} />
  </Fragment>
  <Hero />
  <TeaserVideo />
  <Findings />
  <Play />
  <Results />
  <Release />
  <Humans />
  <Training />
  <Errors />
  <Imagination />
  <Citation />
</Layout>
