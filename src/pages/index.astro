---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import BenchmarkOverview from '../components/BenchmarkOverview.astro';
import Algorithm from '../components/Algorithm.astro';
// import ChartsSection from '../components/ChartsSection.astro';
// import FindingsSection from '../components/FindingsSection.astro';  // Hidden: still holds MindCube results
// import TrajectoryViewer from '../components/TrajectoryViewer.astro';  // Hidden but preserved
// import DatasetViewer from '../components/DatasetViewer.astro';  // Hidden until the MindTopo data drop is ready
import AuthorsCitation from '../components/AuthorsCitation.astro';

// Import component-specific styles
import '../styles/section.css';
import '../styles/hero.css';
import '../styles/authors.css';
import '../styles/resources.css';
// import '../styles/trajectoryViewer.css';  // Hidden but preserved
// import '../styles/datasetViewer.css';  // Hidden but preserved

const pageTitle = "MindTopo: Can Foundation Models Reason in Topological Space? | Topological Reasoning Benchmark for MLLMs";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ScholarlyArticle",
      "headline": "MindTopo: Can Foundation Models Reason in Topological Space?",
      "name": "MindTopo: Can Foundation Models Reason in Topological Space?",
      "url": "https://mind-topo.github.io/",
      "datePublished": "2026-08-07",
      "dateModified": "2026-08-07",
      "image": "https://mind-topo.github.io/og-card.jpg",
      "abstract": "Cognitive science treats topological reasoning — the recognition of spatial invariants such as connectivity, enclosure, and knottedness that persist under continuous deformation — as a foundational layer of human spatial cognition. MindTopo evaluates topological intuition in multimodal large language models across five Piagetian primitives (continuity, separation, order, enclosure, and knots) at two cognitive levels: reasoning from a static rendered scene, and planning through an interactive environment. Every task is procedurally generated with controllable difficulty, yielding 13 task types and 11,016 instances.",
      "keywords": "MindTopo, topological reasoning, topological intuition, topology benchmark, spatial reasoning, multimodal large language models, MLLM, foundation models, Piaget, continuity, separation, order, enclosure, knots, planning, world model",
      "author": [
        { "@type": "Person", "name": "Yunfei Ge" },
        { "@type": "Person", "name": "Anbang Liu" },
        { "@type": "Person", "name": "Qineng Wang", "url": "https://qinengwang-aiden.github.io/" },
        { "@type": "Person", "name": "Johnalbert Garnica" },
        { "@type": "Person", "name": "Jianwen Lyu" },
        { "@type": "Person", "name": "Zihan Wang" },
        { "@type": "Person", "name": "Reuben Tan" },
        { "@type": "Person", "name": "Jianfeng Gao" },
        { "@type": "Person", "name": "Ruohan Zhang" },
        { "@type": "Person", "name": "Yining Hong" },
        { "@type": "Person", "name": "Jiajun Wu" },
        { "@type": "Person", "name": "Manling Li", "@id": "https://limanling.github.io/#person", "url": "https://limanling.github.io/" }
      ]
    },
    {
      "@type": "Dataset",
      "name": "MindTopo",
      "description": "A topological reasoning benchmark with 11,016 procedurally generated instances across 13 task types and five topological properties (continuity, separation, order, enclosure, knots), split into 8,016 reasoning questions over rendered scenes and 3,000 interactive planning episodes.",
      "url": "https://mind-topo.github.io/",
      "sameAs": [
        "https://huggingface.co/datasets/MLL-Lab/MindTOPO",
        "https://github.com/mll-lab-nu/MindTopo"
      ],
      "creator": { "@type": "Organization", "name": "MLL Lab, Northwestern University" },
      "keywords": "MindTopo, topological reasoning, topology benchmark, spatial reasoning, MLLM, planning, connectivity, enclosure, knots"
    },
    {
      "@type": "SoftwareSourceCode",
      "name": "MindTopo",
      "codeRepository": "https://github.com/mll-lab-nu/MindTopo",
      "programmingLanguage": "Python"
    },
    {
      "@type": "WebSite",
      "name": "MindTopo",
      "url": "https://mind-topo.github.io/"
    }
  ]
};
---
<Layout title={pageTitle}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    {/*
      Google Scholar (Highwire Press) citation tags. Restore once the paper is on
      arXiv — Scholar needs citation_pdf_url / citation_arxiv_id to index the page.
      <meta name="citation_title" content="MindTopo: Can Foundation Models Reason in Topological Space?" />
      <meta name="citation_author" content="..." />
      <meta name="citation_arxiv_id" content="..." />
      <meta name="citation_pdf_url" content="..." />
    */}
  </Fragment>
  <!-- 1. Teaser Section -->
  <Hero />

  <!-- 2. Benchmark Overview Section -->
  <BenchmarkOverview />

  <!-- Dataset Viewer Section - hidden until the MindTopo data drop is ready -->
  <!-- <DatasetViewer /> -->

  <!-- 3. Leaderboard Section -->
  <Algorithm />

  <!-- Key Findings Section - hidden, still MindCube content -->
  <!-- <FindingsSection /> -->

  <!-- Trajectory Viewer Section (Original Data Viewer) - Hidden but preserved -->
  <!-- <TrajectoryViewer /> -->

  <!-- 4. Citation Section -->
  <AuthorsCitation />
</Layout>

<script>
  // import { initTrajectoryViewer } from '../scripts/trajectoryViewer';  // Hidden but preserved
  // import { initDatasetViewer } from '../scripts/datasetViewer';  // Hidden but preserved
  import { initCitationCopy } from '../scripts/citation';

  document.addEventListener('DOMContentLoaded', () => {
    // Initialize citation copy functionality
    initCitationCopy();

    // Initialize trajectory viewer - Hidden but preserved
    // initTrajectoryViewer();

    // Initialize dataset viewer - Hidden but preserved
    // initDatasetViewer();

    // Text animation for hero section
    const animateTitle = () => {
      const titleElement = document.getElementById('animated-title');

      if (titleElement) {
        // Handle the new two-line title structure
        const titleLines = titleElement.querySelectorAll('.title-line');

        titleLines.forEach((line, lineIndex) => {
          const lineText = (line as HTMLElement).innerText;
          (line as HTMLElement).innerHTML = '';

          for (let i = 0; i < lineText.length; i++) {
            const charSpan = document.createElement('span');
            charSpan.className = 'reveal-char';
            charSpan.style.animationDelay = `${(lineIndex * lineText.length + i) * 0.05}s`;

            // Special handling for spaces to ensure they display correctly
            if (lineText[i] === ' ') {
              charSpan.innerHTML = '&nbsp;';
            } else {
              charSpan.innerText = lineText[i];
            }

                         (line as HTMLElement).appendChild(charSpan);
          }
        });
      }
    };

    // Run animation
    animateTitle();
  });
</script>
